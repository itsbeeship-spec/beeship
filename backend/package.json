{
  "name": "beeship-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "start": "node --max-old-space-size=512 src/app.js",
    "dev": "nodemon --delay 1 src/app.js",
    "build:copy": "node copy-frontend.js",
    "kill": "powershell -ExecutionPolicy Bypass -File kill-port.ps1",
    "restart": "powershell -ExecutionPolicy Bypass -File kill-port.ps1 && npm run dev",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@prisma/adapter-pg": "^5.16.1",
    "@prisma/client": "^5.16.1",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "pg": "^8.12.0",
    "rate-limit-redis": "^5.0.0",
    "zod": "^4.4.3"
  },

  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.16.1"
  }
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}


datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


model User {
  id              String   @id @default(uuid())
  email           String   @unique
  mobile          String   @unique
  firstName       String
  lastName        String
  companyName     String
  shipmentsRange  String
  password        String
  role            String   @default("USER")
  status          String   @default("ACTIVE")
  plan            String   @default("Basic")
  kycStatus       String   @default("NOT_SUBMITTED")
  kycRejectReason String?
  aadhaarNumber   String?
  panNumber       String?
  gstNumber       String?
  aadhaarFrontUrl String?
  aadhaarBackUrl  String?
  panUrl          String?
  
  // Company Address Details
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  pincode           String?

  // Document URL
  gstUrl            String?

  // KYC Details
  businessType      String?
  panName           String?
  aadhaarName       String?

  // Bank Details
  bankHolderName    String?
  bankAccountNumber String?
  bankName          String?
  bankBranch        String?
  bankAccountType   String?
  bankIfsc          String?
  bankChequeUrl     String?

  // Shopify Integration
  shopifyShop        String?
  shopifyAccessToken String?

  orders          Order[]
  documents       Document[]
  payouts         Payout[]
  warehouses      Warehouse[]
  invoiceSetting      InvoiceSetting?
  labelSetting        LabelSetting?
  notificationSetting NotificationSetting?
  autoAssignRules     AutoAssignRule[]
  activityLogs        ActivityLog[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([kycStatus])
}

model Document {
  id        String   @id @default(uuid())
  title     String
  s3Key     String   // S3 file key
  s3Url     String   // S3 public or presigned base URL
  fileSize  Int
  mimeType  String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Order {
  id               String   @id @default(uuid())
  orderId          String   @unique
  customer         String
  product          String
  amount           Float
  status           String   // fulfilled, unfulfilled, cancelled
  method           String   // COD, Prepaid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Custom manual order fields
  phone            String?
  address          String?
  pincode          String?
  city             String?
  state            String?
  companyName      String?
  gstNumber        String?
  billingSame      Boolean? @default(true)
  billingAddress   String?
  billingPhone     String?
  billingPincode   String?
  billingCity      String?
  billingState     String?
  billingCompanyName String?
  billingGstNumber String?

  products         Json?    // Array of product objects

  shippingCharges  Float?   @default(0.0)
  codCharges       Float?   @default(0.0)
  discount         Float?   @default(0.0)
  taxAmount        Float?   @default(0.0)
  weight           Float?   @default(0.0)
  length           String?
  breadth          String?
  height           String?
  collectableAmount Float?  @default(0.0)
  tags             String[] @default([])
  vendor           String?
  awbNumber        String?
  labelUrl         String?
  pickupWarehouse  String?
  rtoWarehouse     String?
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])

  // Composite indexes for frequent combined query patterns
  @@index([userId, status])        // Orders filtered by user+status (ShipmentView, BillingView)
  @@index([userId, createdAt])     // Orders sorted by user+date (OrderView listing)
  @@index([userId, status, createdAt]) // Optimized order filtering + date sorting
  @@index([status, createdAt])     // Dashboard trend + status filter (AdminController)
  @@index([vendor, status])        // Courier performance groupBy (SuperAdmin dashboard)
  @@index([awbNumber])             // Shipment tracking by AWB number
}

model BillingRate {
  id                String   @id @default(uuid())
  courier           String
  withinCity        Float
  withinState       Float
  metroToMetro      Float
  restOfIndia       Float
  northEastAndJk    Float
  addWithinCity     Float?
  addWithinState    Float?
  addMetroToMetro   Float?
  addRestOfIndia    Float?
  addNorthEastAndJk Float?
  weightSlabStep    Float    @default(0.5)
  codCharges        Float
  codPercent        Float
  userId            String   @default("GLOBAL")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([courier, userId])
}

model WalletTransaction {
  id          String   @id @default(uuid())
  txId        String   @unique
  date        DateTime @default(now())
  type        String   @default("shipping") // shipping, recharge, refund, rto, dispute
  awb         String?
  description String
  amount      Float
  couponCode  String?
  status      String   @default("Success")
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
  @@index([type, userId])
}


model Payout {
  id           String   @id @default(uuid())
  payoutId     String   @unique
  date         DateTime
  codCollected Float
  feeCharged   Float
  netRemitted  Float
  status       String   @default("Transferred") // Transferred, Pending
  paymentRef   String?
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model Warehouse {
  id            String   @id @default(uuid())
  name          String
  personName    String
  phone         String
  email         String?
  address1      String
  address2      String?
  city          String
  state         String
  country       String   @default("India")
  pincode       String
  gstNumber     String?
  isDefault     Boolean  @default(false)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model InvoiceSetting {
  id                   String   @id @default(uuid())
  showCompanyName      Boolean  @default(true)
  invoicePrefix        String   @default("")
  hideConsigneeAddress Boolean  @default(false)
  hideWarehouseAddress Boolean  @default(false)
  logoUrl              String?
  signatureUrl         String?
  pageSize             String   @default("A4") // A4, 4x6
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model LabelSetting {
  id                  String   @id @default(uuid())
  showLogo            Boolean  @default(true)
  logoUrl             String?
  useChannelLogo      Boolean  @default(false)
  showSupportContact  Boolean  @default(true)
  supportEmail        String   @default("")
  supportMobile       String   @default("")
  hideCustomerMobile  Boolean  @default(false)
  hideSku             Boolean  @default(false)
  hideProduct         Boolean  @default(false)
  hideQty             Boolean  @default(false)
  hideTotalAmount     Boolean  @default(false)
  hideDiscountAmount  Boolean  @default(false)
  hideOrderAmount     Boolean  @default(false)
  showCodAmount       Boolean  @default(true)
  showPrepaidAmount   Boolean  @default(false)
  trimSkuUpto         Int      @default(20)
  trimProductNameUpto Int      @default(50)
  showLineItemsCount  Int      @default(5)
  labelSize           String   @default("4x6") // A4, 4x6
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model NotificationSetting {
  id                 String   @id @default(uuid())
  smsBrandName       String   @default("")
  smsUseChannelName  Boolean  @default(false)
  waBrandName        String   @default("")
  waUseChannelName   Boolean  @default(false)

  // SMS status switches
  smsBooked          Boolean  @default(true)
  smsInTransit       Boolean  @default(false)
  smsOutForDelivery  Boolean  @default(true)
  smsDelivered       Boolean  @default(true)
  smsCancelled       Boolean  @default(false)
  smsNdr             Boolean  @default(true)

  // WhatsApp status switches
  waBooked           Boolean  @default(false)
  waInTransit        Boolean  @default(false)
  waOutForDelivery   Boolean  @default(true)
  waDelivered        Boolean  @default(false)
  waCancelled        Boolean  @default(false)
  waNdr              Boolean  @default(false)

  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AutoAssignRule {
  id             String   @id @default(uuid())
  name           String
  priority       Int
  enabled        Boolean  @default(true)
  conditionsJoin String   @default("AND") // "AND" or "OR"
  configurations Json     // Array of { field, condition, value }
  priorities     Json     // Array of { courier, percentage, maxCount }
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model ActivityLog {
  id          String   @id @default(uuid())

  // Who performed the action
  adminId     String
  admin       User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminName   String   // snapshot at time of action
  adminRole   String   // snapshot at time of action

  // What was done
  module      String   // e.g. "Orders", "KYC", "Wallet", "Sellers", "Admins"
  action      String   // e.g. "Cancel Order", "Approve KYC", "Credit Wallet"
  targetId    String?  // e.g. order ID, seller ID
  targetLabel String?  // e.g. "#ORD-10245", "BS1024"
  severity    String   @default("INFO")  // INFO, WARNING, CRITICAL, FAILED

  // Extra context
  description String?
  changes     Json?    // { old: {...}, new: {...} }
  ipAddress   String?
  userAgent   String?

  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([module])
  @@index([severity])
  @@index([createdAt])
}

model Coupon {
  id             String   @id @default(uuid())
  code           String   @unique
  title          String   @default("")
  description    String   @default("")
  discountType   String   @default("FLAT") // "FLAT" or "PERCENT"
  discountValue  Float
  minRecharge    Float    @default(0.0)
  maxDiscount    Float?   // Optional cap for percentage discounts
  isFeatured     Boolean  @default(false) // Flash on seller dashboard banner
  active         Boolean  @default(true)
  usageLimit     Int?     // Total global max uses
  usedCount      Int      @default(0)
  expiryDate     DateTime?
  targetSellerId String?  // Specific Seller ID (null or "ALL" means all sellers)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([code])
  @@index([isFeatured, active])
  @@index([targetSellerId])
}

model GlobalNotificationSetting {
  id                String   @id @default("GLOBAL")
  
  // Email Settings (SMTP / AWS SES)
  emailProvider     String   @default("SMTP") // "SMTP" or "SES"
  emailHost         String   @default("smtp.gmail.com")
  emailPort         Int      @default(587)
  emailUser         String   @default("")
  emailPass         String   @default("")
  fromEmail         String   @default("notifications@beeship.com")
  fromName          String   @default("BeeShip Alerts")

  // SMS Settings (Fast2SMS / MSG91)
  smsProvider       String   @default("FAST2SMS") // "FAST2SMS", "MSG91", "TWILIO"
  smsApiKey         String   @default("")
  smsSenderId       String   @default("BEESHIP")
  smsDltEntityId    String   @default("")

  // WhatsApp Settings (Meta WABA / Interakt)
  waProvider        String   @default("META_WABA") // "META_WABA", "INTERAKT", "AISENSY"
  waPhoneNumberId   String   @default("")
  waWabaId          String   @default("")
  waAccessToken     String   @default("")
  waPhoneNumber     String   @default("")

  // Push Notification Settings (FCM)
  fcmServerKey      String   @default("")
  fcmVapidKey       String   @default("")

  updatedAt         DateTime @updatedAt
}

model NotificationTemplate {
  id           String   @id @default(uuid())
  channel      String   // "EMAIL", "SMS", "WHATSAPP", "PUSH"
  eventKey     String   // e.g. "ORDER_CREATED", "ORDER_SHIPPED", "OFD", "DELIVERED", "NDR", "RECHARGE"
  title        String
  subject      String?  // For Email
  content      String   // Content with {{customer_name}}, {{awb_number}}, {{seller_brand_name}}, etc.
  dltTemplateId String? // For SMS DLT approval
  waApproved   Boolean  @default(true) // For WhatsApp template approval
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([channel, eventKey])
}

model BroadcastLog {
  id           String   @id @default(uuid())
  subject      String
  message      String
  targetType   String   @default("ALL") // "ALL", "ACTIVE", "SPECIFIC"
  targetSellerId String?
  channels     String[] // ["EMAIL", "SMS", "WHATSAPP", "PUSH"]
  recipientCount Int    @default(0)
  status       String   @default("SENT") // "SENT", "SCHEDULED", "FAILED"
  createdAt    DateTime @default(now())
}

model SupportTicket {
  id             String   @id @default(uuid())
  ticketNumber   String   @unique
  userId         String?
  sellerName     String   @default("")
  email          String   @default("")
  subject        String
  category       String   @default("General Inquiry")
  priority       String   @default("MEDIUM") // "LOW", "MEDIUM", "HIGH", "URGENT"
  status         String   @default("OPEN")   // "OPEN", "IN_PROGRESS", "RESOLVED", "CLOSED"
  assignedAgent  String   @default("Unassigned")
  lastReply      String   @default("Ticket opened by merchant")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ticketNumber])
  @@index([status])
  @@index([priority])
}

model SLAConfig {
  id                    String   @id @default("GLOBAL")
  firstResponseSlaHours Int      @default(2)
  resolutionSlaHours    Int      @default(24)
  escalationEmail       String   @default("support-escalations@beeship.com")
  updatedAt             DateTime @updatedAt
}

model AgentAssignRule {
  id                       String   @id @default("GLOBAL")
  autoAssignEnabled        Boolean  @default(true)
  assignmentMode           String   @default("ROUND_ROBIN") // "ROUND_ROBIN" or "LOAD_BALANCED"
  maxActiveTicketsPerAgent Int      @default(15)
  updatedAt                DateTime @updatedAt
}

model LiveChatSession {
  id            String   @id @default(uuid())
  chatId        String   @unique
  sellerName    String
  email         String   @default("")
  lastMessage   String   @default("")
  unreadCount   Int      @default(0)
  status        String   @default("ACTIVE") // "ACTIVE", "WAITING", "CLOSED"
  assignedAgent String   @default("Unassigned")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}



# ─── BeeShip Backend — Environment Variables Template ──────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Server Configuration
PORT=5000
NODE_ENV=development   # development | production

# Frontend origin allowed by CORS (no trailing slash)
# Development: http://localhost:3000
# Production:  https://app.yourdomain.com
CLIENT_ORIGIN=http://localhost:3000

# Authentication
JWT_SECRET=replace-with-a-long-random-secret-at-least-64-chars
JWT_EXPIRES_IN="7d"

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Redis Cache Connection
REDIS_URL="rediss://default:PASSWORD@your-redis-host:6379"

# AWS S3 Storage Settings
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your-bucket-name

# Shipping Integrations API Configuration
# Set to 'mock' or leave empty to run in developer mock mode
DELHIVERY_API_KEY=""
DELHIVERY_ENV="sandbox"   # sandbox | production

XPRESSBEES_API_KEY=""
XPRESSBEES_ENV="sandbox"

AMAZON_SHIPPING_API_KEY=""
AMAZON_SHIPPING_ENV="sandbox"

BLUEDART_API_KEY=""
BLUEDART_ENV="sandbox"

# Shopify Integration Configuration (For App OAuth)
SHOPIFY_API_KEY="your-shopify-client-id"
SHOPIFY_API_SECRET="your-shopify-client-secret"
SHOPIFY_REDIRECT_URI="http://localhost:5000/api/shopify/callback"
